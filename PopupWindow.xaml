<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FolderDock.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FolderDock">

    <Grid x:Name="Root" RequestedTheme="Default"
          CornerRadius="8"
          BorderThickness="1"
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
        <Grid.Background>
            <SolidColorBrush Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.97"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnDismissAccelerator"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator"/>
        </Grid.KeyboardAccelerators>

        <!-- Заголовок -->
        <Grid x:Name="Header" Grid.Row="0" Padding="8,10,8,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SearchColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Margin="0,0,6,0"
                    Padding="6" Background="Transparent" BorderThickness="0"
                    Visibility="Collapsed"
                    Click="OnNavigateBack">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBox x:Name="SearchBox" Grid.Row="1" Grid.ColumnSpan="4"
                     Margin="2,6,2,2" MinHeight="32"
                     VerticalAlignment="Center" TextChanged="OnSearchTextChanged"/>
            <StackPanel x:Name="HeaderActions" Grid.Column="3"
                        Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="PinToggle" Margin="6,0,0,0"
                              Padding="6" Background="Transparent" BorderThickness="0"
                              IsChecked="False" Click="OnTogglePin">
                    <FontIcon Glyph="&#xE718;" FontSize="14"/>
                </ToggleButton>
                <Button x:Name="ViewToggle" Margin="2,0,0,0"
                        Padding="6" Background="Transparent" BorderThickness="0"
                        Click="OnToggleView">
                    <FontIcon x:Name="ViewToggleIcon" Glyph="&#xE8FD;" FontSize="14"/>
                </Button>
                <Button x:Name="OpenExplorerButton" Margin="2,0,0,0"
                        Padding="6" Background="Transparent" BorderThickness="0"
                        Click="OnOpenInExplorer">
                    <FontIcon Glyph="&#xE838;" FontSize="14"/>
                </Button>
                <Button x:Name="CloseButton" Margin="2,0,0,0"
                        Padding="6" Background="Transparent" BorderThickness="0"
                        Click="OnClosePopup">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Сетка -->
        <GridView x:Name="ItemsGrid" Grid.Row="1"
                  Padding="10,0,10,10"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  CanDragItems="True"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  Visibility="Visible">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:FolderEntry">
                    <StackPanel Width="92" Padding="4,8" Spacing="4"
                                Background="Transparent"
                                RightTapped="OnItemRightTapped"
                                ToolTipService.ToolTip="{x:Bind Name}">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Width="48" Height="48"
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Name}" FontSize="12"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" MaxLines="2" Height="32"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Список -->
        <ListView x:Name="ItemsList" Grid.Row="1"
                  Padding="6,0,6,10"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  CanDragItems="True"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FolderEntry">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="2,4"
                                Background="Transparent"
                                RightTapped="OnItemRightTapped">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Width="20" Height="20"/>
                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="10,0,10,10"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Opacity="0.6" Visibility="Collapsed"/>
    </Grid>
</Window>
