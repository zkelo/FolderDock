<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FolderDock.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FolderDock">

    <Grid x:Name="Root" RequestedTheme="Default"
          CornerRadius="8"
          BorderThickness="1"
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
          Background="Transparent">
        <Grid.Resources>
            <Style x:Key="SelectedEntryStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemControlHighlightListAccentLowBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnDismissAccelerator"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator"/>
        </Grid.KeyboardAccelerators>

        <!-- Заголовок -->
        <Grid x:Name="Header" Grid.Row="0" Padding="8,10,8,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SearchColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Margin="0,0,6,0"
                    Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="8"
                    Visibility="Collapsed"
                    Click="OnNavigateBack">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBox x:Name="SearchBox" Grid.Row="1" Grid.ColumnSpan="4"
                     Margin="2,6,2,2" MinHeight="32" CornerRadius="16"
                     VerticalAlignment="Center" TextChanged="OnSearchTextChanged"/>
            <StackPanel x:Name="HeaderActions" Grid.Column="3"
                        Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="PinToggle" Margin="6,0,0,0"
                              Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="8"
                              IsChecked="False" Click="OnTogglePin">
                    <FontIcon Glyph="&#xE718;" FontSize="14"/>
                </ToggleButton>
                <Button x:Name="ViewToggle" Margin="2,0,0,0"
                        Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="8"
                        Click="OnToggleView">
                    <FontIcon x:Name="ViewToggleIcon" Glyph="&#xE8FD;" FontSize="14"/>
                </Button>
                <Button x:Name="SortButton" Margin="2,0,0,0"
                        Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem x:Name="SortByName" x:Uid="SortByName"
                                                 GroupName="FolderSort" Click="OnSortByName"/>
                            <RadioMenuFlyoutItem x:Name="SortByDateAdded" x:Uid="SortByDateAdded"
                                                 GroupName="FolderSort" Click="OnSortByDateAdded"/>
                            <RadioMenuFlyoutItem x:Name="SortByDateModified" x:Uid="SortByDateModified"
                                                 GroupName="FolderSort" Click="OnSortByDateModified"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="OpenExplorerButton" Margin="2,0,0,0"
                        Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="8"
                        Click="OnOpenInExplorer">
                    <FontIcon Glyph="&#xE838;" FontSize="14"/>
                </Button>
                <Button x:Name="CloseButton" Margin="2,0,0,0"
                        Padding="6" Background="Transparent" BorderThickness="0" CornerRadius="8"
                        Click="OnClosePopup">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- A translucent reading surface leaves the native acrylic exposed around it. -->
        <Grid Grid.Row="1" Margin="6,0,6,6" CornerRadius="10"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ItemsHost" Background="Transparent">
                <!-- Сетка -->
                <GridView x:Name="ItemsGrid" Margin="3,0,0,0"
                          Padding="0,0,3,3"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnItemClick"
                          CanDragItems="False"
                          Visibility="Visible">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:FolderEntry">
                            <Grid Width="92" Background="Transparent" RightTapped="OnItemRightTapped"
                                  ToolTipService.ToolTip="{x:Bind DisplayPath}">
                                <Border Style="{StaticResource SelectedEntryStyle}"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                <StackPanel Padding="4,8" Spacing="4">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Width="48" Height="48"
                                           HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" MaxLines="2" Height="32"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Список -->
                <ListView x:Name="ItemsList" Margin="3,0,0,0"
                          Padding="0,0,3,3"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnItemClick"
                          CanDragItems="False"
                          Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FolderEntry">
                            <Grid ColumnSpacing="10" Padding="2,4" Background="Transparent"
                                  RightTapped="OnItemRightTapped"
                                  ToolTipService.ToolTip="{x:Bind DisplayPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Style="{StaticResource SelectedEntryStyle}"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Width="20" Height="20"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind RelativePath}" Visibility="{x:Bind PathVisibility}"
                                               FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed"
                               Fill="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                               Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1"/>
                </Canvas>
            </Grid>

            <TextBlock x:Name="EmptyText" Margin="3,0,3,3" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Opacity="0.6" Visibility="Collapsed"/>
            <TextBlock x:Name="SearchStatus" Grid.Row="1" Margin="3,0,3,1"
                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxLines="2"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
