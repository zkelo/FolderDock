<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FolderDock.ManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FolderDock"
    Title="FolderDock">
    <!-- Заголовок перезаписывается в ApplyAppInfo: «FolderDock <версия>» -->

    <!-- Leave the outer frame clear so the native desktop acrylic stays visible. -->
    <Grid x:Name="ManagerRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The native caption buttons occupy the right side of the title bar. -->
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Height="32" Margin="0,0,152,0"
              Padding="16,0,0,0" ColumnSpacing="8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="TitleBarText" Grid.Column="1" Text="FolderDock" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Border Grid.Row="1" Margin="16" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="24">
            <Grid RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="24"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="FolderDock" VerticalAlignment="Center"
                               Style="{ThemeResource TitleTextBlockStyle}"/>
                    <Button Grid.Column="2" Click="OnAddFolder" Style="{ThemeResource AccentButtonStyle}"
                            VerticalAlignment="Center" CornerRadius="8" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F4;" FontSize="16"/>
                            <TextBlock x:Uid="AddFolderLabel"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Uid="ManagerIntro"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </Grid>

                <ListView x:Name="PinsList" Grid.Row="1" SelectionMode="None"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Margin" Value="0,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PinInfo">
                            <!-- Background=Transparent — hit-test на всю строку для ПКМ -->
                            <Grid Padding="0,8" ColumnSpacing="12" Background="Transparent"
                                  RightTapped="OnPinRightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="20"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind Folder}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Uid="RevealShortcutButton"
                                        VerticalAlignment="Center"
                                        Click="OnRevealShortcut" Tag="{x:Bind Lnk}" CornerRadius="8"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Низ окна: строка обновлений + строка версии/сборки/ссылки -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <!-- Обновления: компактно (FontSize 12, Opacity 0.8), но с удобной
                         областью нажатия (MinHeight 28) -->
                    <StackPanel Orientation="Horizontal" Spacing="16"
                                HorizontalAlignment="Center">
                        <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdates"
                                FontSize="12" Padding="10,4" MinHeight="28" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="12"/>
                                <TextBlock x:Uid="CheckUpdatesLabel"/>
                            </StackPanel>
                        </Button>
                        <CheckBox x:Name="AutoUpdateCheck" MinHeight="28"
                                  VerticalAlignment="Center"
                                  Checked="OnAutoUpdateToggled" Unchecked="OnAutoUpdateToggled">
                            <TextBlock x:Uid="AutoUpdateLabel" FontSize="12"/>
                        </CheckBox>
                    </StackPanel>

                    <!-- Версия, дата/время сборки, ссылка на репозиторий -->
                    <StackPanel Orientation="Horizontal" Spacing="12"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="•" FontSize="12" Opacity="0.4" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BuildStampText" FontSize="12" Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="BuildStampSeparator" Text="•" FontSize="12" Opacity="0.4"
                                   VerticalAlignment="Center"/>
                        <HyperlinkButton x:Name="RepositoryLink" Content="GitHub"
                                         FontSize="12" Padding="0"
                                         VerticalAlignment="Center"/>
                        <TextBlock x:Name="UpdateStatusText" FontSize="12" Opacity="0.6"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
