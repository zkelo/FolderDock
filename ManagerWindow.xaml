<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FolderDock.ManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FolderDock"
    Title="FolderDock — папки на панели задач">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="FolderDock" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Добавь папку — получишь ярлык. Закрепи его на панели задач (ПКМ → «Закрепить на панели задач»). Клик по ярлыку откроет содержимое папки во всплывающем окне."/>
        </StackPanel>

        <Button Grid.Row="1" Click="OnAddFolder" Style="{ThemeResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8F4;" FontSize="16"/>
                <TextBlock Text="Добавить папку"/>
            </StackPanel>
        </Button>

        <ListView x:Name="PinsList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PinInfo">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Folder}" FontSize="12" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Показать ярлык"
                                Click="OnRevealShortcut" Tag="{x:Bind Lnk}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Низ окна: строка обновлений + строка версии/сборки/ссылки -->
        <StackPanel Grid.Row="3" Spacing="4">
            <!-- Обновления: компактно (FontSize 12, Opacity 0.8), но с удобной
                 областью нажатия (MinHeight 28) -->
            <StackPanel Orientation="Horizontal" Spacing="16"
                        HorizontalAlignment="Center" Opacity="0.8">
                <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdates"
                        FontSize="12" Padding="10,4" MinHeight="28"
                        Background="Transparent"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="12"/>
                        <TextBlock Text="Проверить обновления"/>
                    </StackPanel>
                </Button>
                <CheckBox x:Name="AutoUpdateCheck" MinHeight="28"
                          VerticalAlignment="Center"
                          Checked="OnAutoUpdateToggled" Unchecked="OnAutoUpdateToggled">
                    <TextBlock Text="Проверять автоматически" FontSize="12"/>
                </CheckBox>
            </StackPanel>

            <!-- Версия, дата/время сборки, ссылка на репозиторий -->
            <StackPanel Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center"/>
                <TextBlock Text="•" FontSize="12" Opacity="0.4" VerticalAlignment="Center"/>
                <TextBlock x:Name="BuildStampText" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BuildStampSeparator" Text="•" FontSize="12" Opacity="0.4"
                           VerticalAlignment="Center"/>
                <HyperlinkButton x:Name="RepositoryLink" Content="GitHub"
                                 FontSize="12" Padding="0"
                                 VerticalAlignment="Center"/>
                <TextBlock x:Name="UpdateStatusText" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
